# 复制为 .env 后使用。示例哈希对应密码：admin123，请务必在正式使用前替换。
ADMIN_PASSWORD_HASH=pbkdf2_sha256$260000$7d93940472d84734482d00f1140fad40$5b310b138335cddbce98e52d4db140f300c4fa2ecdeccfae9dbeddd783fd9cea

# 请替换为随机长字符串，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false

DATABASE_PATH=data/pingcheck.db
APP_PORT=8080

# 监控默认值一般无需修改
MONITOR_INTERVAL_SECONDS=60
DETECTION_TIMEOUT_SECONDS=5
MAX_CONCURRENT_CHECKS=10
HISTORY_RETENTION_DAYS=30
